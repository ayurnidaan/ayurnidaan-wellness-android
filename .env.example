# Copy this file to .env.local for local development.
# These values are embedded in the app and are not secrets. Security must come
# from Supabase Row Level Security policies. Never put a service_role key here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_DEVELOPMENT_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEVELOPMENT_PUBLISHABLE_OR_ANON_KEY
